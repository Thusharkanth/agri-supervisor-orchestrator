# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Agri Decision-Support System"
APP_VERSION="1.0.0"
DEBUG=true

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=agri_user
POSTGRES_PASSWORD=agri_pass
POSTGRES_DB=agri_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agri_user:agri_pass@localhost:5432/agri_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=3600

# ── Ollama (LLM for Coordinator Node) ─────────────────────────────────────────
# Set to your preferred Ollama model - choose later!
# Examples: llama3.2, mistral, gemma2, qwen2.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Open-Meteo (Free, No API Key Needed) ──────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_SOIL_URL=https://api.open-meteo.com/v1/forecast
