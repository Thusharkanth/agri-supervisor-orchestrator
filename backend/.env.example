# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration — EXAMPLE FILE (safe to commit)
# ⚠️  DO NOT put real credentials here. This file is committed to Git.
# Copy this file to .env and fill in your actual values:
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Agri Decision-Support System"
APP_VERSION="1.0.0"
DEBUG=true

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=agri_db
POSTGRES_HOST=localhost
POSTGRES_PORT=6543
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:6543/agri_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=3600

# ── Ollama (LLM for Coordinator Node) ─────────────────────────────────────────
# Set to your preferred Ollama model
# Examples: llama3.2, mistral, gemma2, qwen3.5:cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=your_ollama_model

# ── Open-Meteo (Free, No API Key Needed) ──────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_SOIL_URL=https://api.open-meteo.com/v1/forecast
